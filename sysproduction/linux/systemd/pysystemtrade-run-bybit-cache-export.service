[Unit]
Description=pysystemtrade ByBit CSV cache export (run_bybit_cache_export)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=kostya
WorkingDirectory=/home/kostya/projects/pysystemtrade
EnvironmentFile=-/home/kostya/.config/pysystemtrade-environment
Restart=on-failure
RestartSec=60
ExecStart=/home/kostya/projects/pysystemtrade/.venv/bin/python -m sysproduction.run_bybit_cache_export